{
    "name": "sayamaapps/kirby-tegaru",
    "description": "Resizes phone photos in the Kirby Panel before upload, dropping EXIF and GPS data.",
    "type": "kirby-plugin",
    "license": "MIT",
    "keywords": [
        "kirby",
        "kirby-plugin",
        "kirby-5",
        "panel",
        "upload",
        "images",
        "mobile",
        "privacy",
        "exif",
        "gps"
    ],
    "homepage": "https://github.com/sayamaapps/kirby-tegaru",
    "authors": [
        {
            "name": "Simon Räder",
            "homepage": "https://sayamaapps.de"
        }
    ],
    "support": {
        "issues": "https://github.com/sayamaapps/kirby-tegaru/issues",
        "source": "https://github.com/sayamaapps/kirby-tegaru"
    },
    "require": {
        "php": "^8.2",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^5.0",
        "phpunit/phpunit": "11.5.55"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "installer-name": "tegaru",
        "kirby-cms-path": false,
        "kirby": {
            "compatible": "^5.0"
        }
    }
}
